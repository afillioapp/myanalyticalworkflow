{
  "name": "bsa-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:reset": "tsx scripts/db.ts reset",
    "db:seed": "tsx scripts/db.ts seed",
    "vercel-build": "tsx scripts/db.ts migrate && next build"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
